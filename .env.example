# Server-only AI provider keys. Read via process.env in server.ts /
# src/lib/aiProviders.server.ts ONLY. Never reference these with
# import.meta.env in client code — Vite inlines VITE_-prefixed vars that are
# referenced from client code into the browser bundle, which leaks secrets.
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Firebase client config — safe to expose in the browser (protected by
# firestore.rules, not secrecy).
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-only) — from a service account JSON, used by
# server.ts to verify ID tokens and read/write Firestore with elevated access.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# The site's public URL, no trailing slash. Stamped into index.html at build time for the
# canonical link and the social share tags (og:image and friends), which MUST be absolute -
# a scraper fetching a share card has no page to resolve a relative path against.
# Leave it unset in dev; the build warns and falls back to root-relative URLs.
VITE_SITE_URL=https://your-domain.com

# Google Analytics measurement ID (looks like G-XXXXXXXXXX). Leave BLANK to disable
# analytics entirely - no script is loaded and no cookie is set when this is empty.
VITE_GA_ID=

# ---------------------------------------------------------------------------
# AI PROVIDERS
#
# Only GEMINI_API_KEY is needed to run. Every other key here is OPTIONAL and
# adds a separate company's free tier to the fallback chain — a provider with
# no key set is skipped silently.
#
# More providers, not more accounts: see AI_PROVIDERS.md for why holding
# several accounts at one company is both against their terms and a good way
# to lose the account the live app runs on.
#
# Check what is alive at any time with:  npm run check:ai
# ---------------------------------------------------------------------------
# CEREBRAS_API_KEY=          # https://cloud.cerebras.ai/
# MISTRAL_API_KEY=           # https://console.mistral.ai/api-keys/
# GITHUB_MODELS_TOKEN=       # https://github.com/settings/tokens (fine-grained, Models: read)
# TOGETHER_API_KEY=          # https://api.together.ai/settings/api-keys

# --- Email (optional, but reset-by-code and reminders need it) ---------------
# Resend: one HTTPS POST, 3,000 emails/month free. https://resend.com/api-keys
# Without this, reset-by-code returns a clear "not switched on yet" and the
# emailed reset LINK still works.
RESEND_API_KEY=
# Set once a domain is verified in Resend, or mail lands in spam.
# Until then the sandbox sender (onboarding@resend.dev) is used automatically.
EMAIL_FROM=StudyQuest <noreply@studyquest.app>

# ── TURN (optional) ──────────────────────────────────────────────────────────
# Study-room calls are peer-to-peer and cost nothing wherever the network
# allows it. Where it does not -- symmetric NAT, or a school firewall blocking
# UDP -- the media has to be relayed, and that is what TURN does.
#
# LEAVE THESE BLANK AND EVERYTHING STILL WORKS. Calls fall back to STUN only,
# exactly as before, and simply keep failing on hostile networks.
#
# Get them from https://dash.cloudflare.com/?to=/:account/calls -> create a TURN
# key. Cloudflare's free tier is 1,000 GB/month, which is tens of thousands of
# audio call-hours, and only the calls that CANNOT go peer-to-peer use any of it.
#
# The API token is a long-term secret: it is used server-side only and exchanged
# for short-lived credentials. It must never reach the browser.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
