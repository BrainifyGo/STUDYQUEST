rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - notifications: boolean (optional)
    //   - isPro: boolean (optional)
    //   - dailyGenerations: number (optional)
    //   - lastGenerationDate: string (optional)
    //   - subscriptionType: string (optional, enum: ['monthly', 'annual', 'none'])
    //   - xp: number (optional)
    //   - level: number (optional)
    //   - badges: list (optional)
    //
    // Collection: exams
    // Document ID: examId
    // Fields:
    //   - userId: string (required)
    //   - subject: string (required)
    //   - date: string (required)
    //   - importance: string (required, enum: ['low', 'medium', 'high'])
    //   - completed: boolean (required)
    //   - createdAt: string (required)
    //
    // Collection: study_tasks
    // Document ID: taskId
    // Fields:
    //   - userId: string (required)
    //   - title: string (required)
    //   - subject: string (required)
    //   - duration: number (required)
    //   - date: string (required)
    //   - completed: boolean (required)
    //   - createdAt: string (required)
    //
    // Collection: study_sessions
    // Document ID: sessionId
    // Fields:
    //   - userId: string (required)
    //   - date: string (required)
    //   - duration: number (required)
    //   - score: number (required)
    //   - subject: string (optional)
    //
    // Collection: upgrade_keys
    // Document ID: keyId
    // Fields:
    //   - key: string (required)
    //   - type: string (required, enum: ['monthly', 'annual'])
    //   - isUsed: boolean (required)
    //   - usedBy: string (optional)
    //
    // Collection: study_history
    // Document ID: historyId
    // Fields:
    //   - user_id: string (required)
    //   - subject: string (required)
    //   - timestamp: string (optional)
    //   - mode: string (optional)
    //   - content: string (optional)
    //   - outputModes: map (optional)
    //   - created_at: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "olamidepeniel@gmail.com" && request.auth.token.email_verified == true) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() < 128 &&
             data.email is string && data.email.size() < 256 &&
             (!('displayName' in data) || data.displayName is string && data.displayName.size() < 100) &&
             (!('notifications' in data) || data.notifications is bool) &&
             (!('isPro' in data) || data.isPro is bool) &&
             (!('dailyGenerations' in data) || data.dailyGenerations is int) &&
             (!('lastGenerationDate' in data) || data.lastGenerationDate is string && data.lastGenerationDate.size() < 64) &&
             (!('subscriptionType' in data) || data.subscriptionType in ['monthly', 'annual', 'none']) &&
             (!('xp' in data) || data.xp is int) &&
             (!('level' in data) || data.level is int) &&
             (!('badges' in data) || data.badges is list && data.badges.size() < 50) &&
             (!('redeemedKey' in data) || data.redeemedKey is string && data.redeemedKey.size() < 128) &&
             (!('proSource' in data) || data.proSource in ['key', 'subscription']);
    }

    function isValidExam(data) {
      return data.keys().hasAll(['userId', 'subject', 'date', 'importance', 'completed', 'createdAt']) &&
             data.userId is string && data.userId.size() < 128 &&
             data.subject is string && data.subject.size() < 100 &&
             data.date is string && data.date.size() < 64 &&
             data.importance in ['low', 'medium', 'high'] &&
             data.completed is bool &&
             data.createdAt is string && data.createdAt.size() < 64;
    }

    function isValidStudyTask(data) {
      return data.keys().hasAll(['userId', 'title', 'subject', 'duration', 'date', 'completed', 'createdAt']) &&
             data.userId is string && data.userId.size() < 128 &&
             data.title is string && data.title.size() < 200 &&
             data.subject is string && data.subject.size() < 100 &&
             data.duration is number &&
             data.date is string && data.date.size() < 64 &&
             data.completed is bool &&
             data.createdAt is string && data.createdAt.size() < 64;
    }

    function isValidStudySession(data) {
      return data.keys().hasAll(['userId', 'date', 'duration', 'score']) &&
             data.userId is string && data.userId.size() < 128 &&
             data.date is string && data.date.size() < 64 &&
             data.duration is number &&
             data.score is number &&
             (!('subject' in data) || data.subject is string && data.subject.size() < 100);
    }

    function isValidStudyHistory(data) {
      return data.keys().hasAll(['user_id', 'subject', 'created_at']) &&
             data.user_id is string && data.user_id.size() < 128 &&
             data.subject is string && data.subject.size() < 100 &&
             data.created_at is string && data.created_at.size() < 64 &&
             (!('timestamp' in data) || data.timestamp is string && data.timestamp.size() < 64) &&
             (!('mode' in data) || data.mode is string && data.mode.size() < 64) &&
             (!('content' in data) || data.content is string && data.content.size() < 10000) &&
             (!('outputModes' in data) || data.outputModes is map);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // FIELDS A USER MAY NEVER CHANGE ON THEIR OWN DOCUMENT.
    //
    // isValidUser() checks that isPro is a bool — and `true` is a bool, so it happily allowed
    // any signed-in user to run this in the browser console and get a free subscription:
    //
    //     updateDoc(doc(db, 'users', myUid), { isPro: true })
    //
    // `role` was already protected exactly this way; these fields simply never got the same
    // treatment. Validating the SHAPE of data is not the same as deciding who may change it.
    //
    // NOT listed here: `dailyGenerations`. It looks like a quota, but nothing gates on it any
    // more — App.tsx checks `tokensUsedToday` against the real limit and says so in a comment.
    // It is now just a counter the app writes on every generation, so pinning it broke every
    // one of those writes, and with them the xp/level/badges/streak fields written alongside.
    // Protect what actually costs money, and only that.
    function paidFieldsUnchanged() {
      return request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
          && request.resource.data.get('subscriptionType', 'none') == resource.data.get('subscriptionType', 'none');
    }

    // THE FIELDS THAT DO COST MONEY.
    //
    // Every AI call is charged against `tokensUsedToday`/`tokensUsedThisMonth`, which the server
    // increments with the Admin SDK. The month/day rollover used to run in the browser, which
    // meant the client decided both when the day had ended and what the counter reset to — so
    // `updateDoc(userRef, { tokensUsedToday: 0 })` was unlimited free AI, no upgrade key needed.
    // Rollover now happens in `readBudget()` server-side; the client never writes these.
    function budgetUnchanged() {
      return request.resource.data.get('tokensUsedToday', 0) == resource.data.get('tokensUsedToday', 0)
          && request.resource.data.get('tokensUsedThisMonth', 0) == resource.data.get('tokensUsedThisMonth', 0)
          && request.resource.data.get('tokenResetDate', '') == resource.data.get('tokenResetDate', '')
          && request.resource.data.get('tokenDailyResetDate', '') == resource.data.get('tokenDailyResetDate', '');
    }

    // THE ONE WAY A USER MAY GRANT THEMSELVES PRO: by burning a key that is now stamped with
    // their own uid.
    //
    // Redemption is two writes, and the order is forced by these rules. First the user claims
    // the key itself (isUsed false -> true, usedBy = me), which only succeeds if nobody has
    // claimed it before. Only then does this allow isPro to flip, and only to the plan type
    // recorded on that key. Skipping the first write leaves the second with nothing to point at.
    //
    // This is the no-Cloud-Functions path: Functions need the Blaze plan, and closing the
    // original holes without a replacement would have left nobody able to upgrade at all.
    /*
      `redeemedKey` MAY ONLY CHANGE AS PART OF A REDEMPTION.

      Without this, a key could be spent more than once on the SAME account, in
      three steps:

        1. Redeem key K. The account holds isPro: true, redeemedKey: 'K'.
        2. The subscription lapses and the Lemon Squeezy webhook sets isPro back
           to false. `redeemedKey` is left holding 'K'.
        3. Write { redeemedKey: '' }. That passed, because paidFieldsUnchanged()
           only looks at isPro and subscriptionType — and both are unchanged.
        4. Write { isPro: true, subscriptionType: 'annual', redeemedKey: 'K' }.
           redeemedWithMyKey() now sees k != '' , the key still exists, is still
           isUsed, and is still stamped with this uid. It PASSES.

      Step 3 is the whole bug: the check that a key cannot be re-pointed-at was
      `k != resource.data.redeemedKey`, and that is trivially defeated by first
      clearing the field it compares against. So the field is now pinned on every
      write that is not itself a redemption.

      Note this does NOT affect one key being used by two different accounts —
      that has always been blocked on the key document itself, which only permits
      isUsed false -> true and can never be reset by a client.
    */
    function redeemedKeyUnchanged() {
      return request.resource.data.get('redeemedKey', '') == resource.data.get('redeemedKey', '')
          // `proSource` gets the same treatment for the same reason: if it could
          // be cleared, the protection it grants could be cleared with it.
          && request.resource.data.get('proSource', '') == resource.data.get('proSource', '');
    }

    function redeemedWithMyKey() {
      let k = request.resource.data.get('redeemedKey', '');
      let path = /databases/$(database)/documents/upgrade_keys/$(k);
      return k is string && k.size() > 0
          && k != resource.data.get('redeemedKey', '')
          && exists(path)
          && get(path).data.isUsed == true
          && get(path).data.usedBy == request.auth.uid
          && request.resource.data.get('isPro', false) == true
          && request.resource.data.get('subscriptionType', 'none') == get(path).data.type
          // Stamped as key-granted so the payment webhook knows never to revoke
          // it. A key is a permanent grant; a subscription is not.
          && request.resource.data.get('proSource', '') == 'key';
    }

    match /users/{userId} {
      // Allow users to read/write their own data
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // A new account may not arrive pre-upgraded, or pre-spent.
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && isValidUser(request.resource.data)
                    && (request.resource.data.role == 'client' || !('role' in request.resource.data))
                    && request.resource.data.get('isPro', false) == false
                    && request.resource.data.get('subscriptionType', 'none') == 'none'
                    && request.resource.data.get('tokensUsedToday', 0) == 0
                    && request.resource.data.get('tokensUsedThisMonth', 0) == 0;
      allow update: if isAdmin()
                    || (isAuthenticated() && request.auth.uid == userId
                        && isValidUser(request.resource.data)
                        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
                        && budgetUnchanged()
                        && ((paidFieldsUnchanged() && redeemedKeyUnchanged())
                            || redeemedWithMyKey()));
      // There was NO delete rule here, so "Delete Account" was rejected by the
      // rules every single time and reported as "something went wrong". You are
      // allowed to delete your own account; that is what the button is for.
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidExam(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidExam(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /study_tasks/{taskId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidStudyTask(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidStudyTask(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /study_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidStudySession(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidStudySession(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // AN UPGRADE KEY IS A SECRET, so it must never be readable in bulk.
    //
    // `allow read: if isAuthenticated()` was meant to let someone check the key they were
    // given. What it actually allowed was any signed-in user LISTING THE WHOLE COLLECTION,
    // reading every unused key, and redeeming one — and UpgradePage.tsx already contains the
    // query to copy. A secret you can enumerate is not a secret.
    //
    // The fix is that THE DOCUMENT ID IS NOW THE KEY STRING ITSELF. `get` is allowed to any
    // signed-in user, but `list` is not — so you can look up a key you were given and cannot
    // discover one you weren't. A lookup by exact ID reveals nothing you didn't already have.
    //
    // Claiming a key is a one-way door: unused -> used, stamped with the claimer's uid, and
    // `key`/`type` frozen so nobody can rewrite a spent monthly key into a fresh annual one.
    // Once claimed, `resource.data.isUsed == false` fails forever, so a shared key is worth
    // exactly one upgrade to exactly one account.
    match /upgrade_keys/{keyId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow update: if isAuthenticated()
                    && resource.data.isUsed == false
                    && request.resource.data.isUsed == true
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.get('key', '') == resource.data.get('key', '');
      allow create, delete: if isAdmin();
    }

    // Questions the user got wrong, kept until they get them right. Same owner-only
    // shape as every other study collection — and `delete` matters here as much as
    // the others, because retiring a mistake IS the reward loop.
    function isValidMistake(data) {
      return data.keys().hasAll(['user_id', 'question', 'correctAnswer']) &&
             data.user_id is string && data.user_id.size() < 128 &&
             data.question is string && data.question.size() < 2000 &&
             data.correctAnswer is string && data.correctAnswer.size() < 1000 &&
             (!('options' in data) || data.options is list && data.options.size() < 12) &&
             (!('chosen' in data) || data.chosen is string && data.chosen.size() < 1000) &&
             (!('explanation' in data) || data.explanation is string && data.explanation.size() < 4000) &&
             (!('subject' in data) || data.subject is string && data.subject.size() < 100) &&
             (!('times' in data) || data.times is int);
    }

    match /study_mistakes/{mistakeId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid
                    && isValidMistake(request.resource.data);
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid
                    && isValidMistake(request.resource.data)
                    && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    match /study_history/{historyId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid && isValidStudyHistory(request.resource.data);
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid && isValidStudyHistory(request.resource.data) && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    /* =====================================================================
       FRIENDS

       Two collections, and the whole thing turns on one rule: you may create a
       request FROM yourself, and you may delete one addressed TO you. Nobody can
       write a request on someone else's behalf, and nobody can put themselves in
       your friends list.
       ===================================================================== */

    match /friend_requests/{reqId} {
      // Visible to the two people involved and nobody else. A request is a small
      // fact about a child's social life; it is not public.
      /*
        `resource == null` FIRST, or a missing document is a permission error.

        Firestore evaluates a `get` on a document that does not exist with
        `resource` set to null, so `resource.data.fromUid` throws and the read is
        DENIED rather than returning "not found". That is not a hypothetical:
        sendRequest() checks "have they already asked me?" before writing, and
        that document almost never exists — so adding a friend failed with
        "Missing or insufficient permissions" for everybody who was not already
        a friend, which is everybody.

        Allowing the read when there is no document leaks nothing. There is no
        data to leak.
      */
      allow read: if isAuthenticated()
                  && (resource == null
                      || resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);

      // You may only send a request AS yourself. The document id is pinned to
      // "{from}__{to}" as well, so one person cannot flood another with requests
      // under different ids — a second attempt overwrites the first.
      allow create: if isAuthenticated()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && reqId == request.auth.uid + '__' + request.resource.data.toUid
                    && request.resource.data.fromName is string
                    && request.resource.data.fromName.size() <= 80;

      // A request is never edited. It is accepted or it is deleted.
      allow update: if false;

      // The recipient declines; the sender withdraws.
      allow delete: if isAuthenticated()
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
    }

    match /friendships/{pairId} {
      // Same reason as friend_requests above: areFriends() reads this exact
      // document before a friendship exists, and a null `resource` made that a
      // permission error instead of a plain "no".
      allow read: if isAuthenticated()
                  && (resource == null || request.auth.uid in resource.data.uids);

      /*
        Creating a friendship requires a real request addressed to you.

        Without the exists() check, anyone could write a friendship document
        naming themselves and any uid they liked, and appear in that person's
        friends list uninvited. The check is the entire point of the collection:
        consent has to be proved, not asserted.
      */
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.uids
                    && request.resource.data.uids.size() == 2
                    && pairId == request.resource.data.uids[0] + '__' + request.resource.data.uids[1]
                    && request.resource.data.uids[0] < request.resource.data.uids[1]
                    && exists(/databases/$(database)/documents/friend_requests/$(
                         (request.resource.data.uids[0] == request.auth.uid
                            ? request.resource.data.uids[1]
                            : request.resource.data.uids[0])
                         + '__' + request.auth.uid));

      // Nothing about an existing friendship may be rewritten — in particular
      // not `uids`, which would let one side drag a third person in.
      allow update: if false;

      // Either side may end it, and it ends for both. That is what unfriending
      // means, and a rule that let only one side leave would be a bug.
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.uids;
    }

    /* =====================================================================
       PUBLIC PROFILES

       Searching for a friend means reading a stranger's document, and the rule
       on /users correctly refuses that — a user document holds their email,
       their plan, their token spend and their whole progress. Relaxing it to
       make search work would have handed every signed-in account the lot.

       So the searchable fields live here instead, and nothing else does: a
       display name, a username, and the uid. Written only by its owner.
       ===================================================================== */
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();

      /*
        Written only by POST /api/identity, for the same reason as `usernames`
        above: `displayName` is what people actually read in a friends list, and
        a filtered username beside an unfiltered display name is not a filter.
      */
      allow create, update: if false;

      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    /* =====================================================================
       USERNAMES

       One document per claimed name, id = the name itself in lower case.

       The claim is atomic WITHOUT a transaction, because Firestore `create`
       fails when the document already exists and `update` is forbidden below.
       Two people racing for the same username cannot both win, and nobody can
       take a name off someone by overwriting it.
       ===================================================================== */
    match /usernames/{name} {
      // Readable so the sign-up form can say "taken" before you submit.
      // It holds a uid and nothing else.
      allow read: if isAuthenticated();

      /*
        CLIENTS MAY NO LONGER CREATE A USERNAME.

        These conditions checked SHAPE and nothing else, so the slur filter in
        lib/usernameSafety.ts — which only ever ran in the browser — could be
        walked straight past. Proved on 2026-08-20: a signed-in account POSTed to
        the Firestore REST API and claimed a slur. HTTP 200.

        Rules cannot run that filter; it needs confusable folding, separator
        stripping and run collapsing, none of which exist here. So the claim now
        goes through POST /api/identity, which runs the real check and writes
        with admin credentials (which bypass these rules). Denying create here is
        what makes that route the only way in.
      */
      allow create: if false;

      // Never rewritten — that is what makes the create above a lock.
      allow update: if false;

      // Released only by its owner, when they change name or delete the account.
      allow delete: if isAuthenticated()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* =====================================================================
       DIRECT MESSAGES

       Document id is the same sorted-pair id as the friendship, so the rule can
       check the friendship exists without storing a second copy of who is
       allowed. Messages are a subcollection of that.

       YOU MUST BE FRIENDS. Not "must have been friends when you started" — the
       exists() runs on every read and every write, so removing someone ends the
       conversation for both sides immediately. That is what unfriending has to
       mean on an app used by children.
       ===================================================================== */
    match /dms/{pairId}/messages/{messageId} {
      function inThisPair() {
        return isAuthenticated() && pairId.split('__').hasAny([request.auth.uid]);
      }
      function stillFriends() {
        return exists(/databases/$(database)/documents/friendships/$(pairId));
      }

      allow read: if inThisPair() && stillFriends();

      allow create: if inThisPair() && stillFriends()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.sentAt is string;

      // A message is not edited. Rewriting what someone said after they read it
      // is not a feature we want, and it is not one we are going to leave open.
      allow update: if false;

      // You may delete your own message. You may not delete theirs.
      allow delete: if inThisPair() && resource.data.senderUid == request.auth.uid;
    }

    /* =====================================================================
       FRIEND STATS

       Your level, XP and streak, readable by you and by your friends — and by
       nobody else.

       This is FREE, deliberately, and it is the whole point of the friends
       feature being free: seeing where your friends are is the reason to add
       one. The paid feature is the study room.

       Why a separate collection rather than a few more fields on the user doc:
       /users holds email, plan, token spend and redeemed keys, and the rule
       there correctly refuses to show any of it to anyone else. Loosening that
       to expose a level would expose everything beside it.

       The friendship id is the two uids sorted and joined, exactly as
       lib/friends.ts builds it, so the check is one exists() with no query.
       ===================================================================== */
    match /user_stats/{userId} {
      function friendshipWith(other) {
        return request.auth.uid < other
          ? request.auth.uid + '__' + other
          : other + '__' + request.auth.uid;
      }

      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || exists(/databases/$(database)/documents/friendships/$(friendshipWith(userId)))
      );

      // Only you write your own, and only these fields — a stats document that
      // could hold anything would become a second, unguarded profile.
      allow create, update: if isAuthenticated()
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(
                                 ['uid', 'displayName', 'level', 'xp', 'streak', 'sessions', 'updatedAt'])
                            && request.resource.data.uid == userId
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 60
                            && request.resource.data.level is int
                            && request.resource.data.xp is int
                            && request.resource.data.get('streak', 0) is int
                            && request.resource.data.get('sessions', 0) is int;

      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    /* =====================================================================
       CHALLENGES — race a friend through the same questions. FREE.

       Study rooms are the paid feature. Challenging a friend is the reason to
       add one, and a friends list where every button leads to a paywall is not
       a free feature.
       ===================================================================== */
    match /challenges/{challengeId} {
      function amIn(uids) {
        return request.auth.uid in uids;
      }
      function friendshipOf(uids) {
        return /databases/$(database)/documents/friendships/$(uids[0] + '__' + uids[1]);
      }

      allow read: if isAuthenticated() && amIn(resource.data.uids);

      /*
        You may only challenge someone you are ALREADY FRIENDS WITH.

        Without the exists() below, a challenge would be a way to push content
        at a stranger — questions, and a name, into their app. The friends list
        is the consent step, and this is where that consent is checked.
      */
      allow create: if isAuthenticated()
                    && request.resource.data.fromUid == request.auth.uid
                    && amIn(request.resource.data.uids)
                    && request.resource.data.uids.size() == 2
                    && request.resource.data.uids[0] < request.resource.data.uids[1]
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.questions is list
                    && request.resource.data.questions.size() > 0
                    && request.resource.data.questions.size() <= 30
                    && request.resource.data.topic is string
                    && request.resource.data.topic.size() <= 80
                    && exists(friendshipOf(request.resource.data.uids));

      /*
        Never edited. Changing the questions after somebody has answered them is
        the one thing that would make a score meaningless, so it is not a rule
        to get right — it is a thing that cannot happen.
      */
      allow update: if false;

      allow delete: if isAuthenticated() && amIn(resource.data.uids);
    }

    /*
      One document per player, WRITTEN ONCE.

      `allow update: if false` is what stops someone replaying a challenge until
      they beat their friend. Keeping each score in its own document is also why
      the rules never have to reason about which keys of a shared map changed,
      which is where this sort of thing usually goes wrong.
    */
    match /challenges/{challengeId}/scores/{playerId} {
      function challenge() {
        return get(/databases/$(database)/documents/challenges/$(challengeId)).data;
      }

      allow read: if isAuthenticated() && request.auth.uid in challenge().uids;

      allow create: if isAuthenticated()
                    && playerId == request.auth.uid
                    && request.auth.uid in challenge().uids
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'score', 'accuracy', 'correct', 'answered', 'at'])
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.accuracy is int
                    && request.resource.data.accuracy >= 0
                    && request.resource.data.accuracy <= 100;

      allow update: if false;

      // Only your own, and only so a deleted account can clean up after itself.
      allow delete: if isAuthenticated() && playerId == request.auth.uid;
    }
  }
}
