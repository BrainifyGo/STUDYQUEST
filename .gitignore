# Scratch files used to pass multi-line commit messages to `git commit -F`.
# Twice now one has been picked up by `git add -A` because the file was still
# there when the add ran. Ignored so the mistake cannot repeat.
.msg.tmp
commitmsg.txt
*.local.cjs
