{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, subscription status, and gamification data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "notifications": { "type": "boolean" },
        "isPro": { "type": "boolean" },
        "dailyGenerations": { "type": "integer" },
        "lastGenerationDate": { "type": "string" },
        "studyDays": { "type": "array", "items": { "type": "string" } },
        "subscriptionType": { "type": "string", "enum": ["monthly", "annual", "none"] },
        "xp": { "type": "integer" },
        "level": { "type": "integer" },
        "badges": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Upcoming exam or deadline",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string" },
        "importance": { "type": "string", "enum": ["low", "medium", "high"] },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "subject", "date"]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "A specific study task generated by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "duration": { "type": "integer" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "subject", "date"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "A single study session record for analytics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "duration": { "type": "number" },
        "score": { "type": "number" },
        "subject": { "type": "string" }
      },
      "required": ["userId", "date", "duration"]
    },
    "UpgradeKey": {
      "title": "UpgradeKey",
      "description": "A key used to unlock Pro features",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "type": { "type": "string", "enum": ["monthly", "annual"] },
        "isUsed": { "type": "boolean" },
        "usedBy": { "type": "string" }
      },
      "required": ["key", "type", "isUsed"]
    },
    "StudyHistory": {
      "title": "StudyHistory",
      "description": "Historical record of generated study content",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "subject": { "type": "string" },
        "timestamp": { "type": "string" },
        "mode": { "type": "string" },
        "content": { "type": "string" },
        "outputModes": { "type": "object" },
        "created_at": { "type": "string" }
      },
      "required": ["user_id", "subject", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/study_sessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Study session records"
    },
    "/upgrade_keys/{keyId}": {
      "schema": "UpgradeKey",
      "description": "Available upgrade keys"
    },
    "/study_history/{historyId}": {
      "schema": "StudyHistory",
      "description": "Study history records"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Upcoming exams"
    },
    "/study_tasks/{taskId}": {
      "schema": "StudyTask",
      "description": "AI generated study tasks"
    }
  }
}
